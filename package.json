{
  "name": "@blockchainhub/coco",
  "version": "2.3.0",
  "description": "A modern, JavaScript-free CSS framework built with Sass.",
  "keywords": [
    "css",
    "css-framework",
    "framework",
    "front-end",
    "responsive",
    "sass",
    "scss",
    "sass-framework",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bchainhub/coco.git"
  },
  "bugs": {
    "url": "https://github.com/bchainhub/coco/issues"
  },
  "homepage": "https://bchainhub.github.io/coco/",
  "scripts": {
    "autoprefixer": "postcss dist/*.css -u autoprefixer --replace --no-map",
    "audit": "npm audit --audit-level=low",
    "serve": "serve preview --listen 3000 --no-clipboard",
    "delete:dev-folder": "del-cli --force dist",
    "build": "npm-run-all delete:dev-folder build:prod",
    "build:prod": "npm-run-all sass:prod:expanded sass:prod:compressed autoprefixer",
    "pug": "pug3 --obj preview/pug/assets/data.json --watch preview/pug/ --out preview/html/ --pretty",
    "pug:build": "pug3 --obj preview/pug/assets/data.json preview/pug/ --out preview/html/ --pretty",
    "sass:preview": "sass --watch --update --style=expanded --no-source-map scss/coco-styles.scss:preview/assets/css/coco.css --load-path=scss",
    "sass:prod:expanded": "sass --no-source-map --style=expanded scss/coco-styles.scss:dist/coco.css",
    "sass:prod:compressed": "sass --no-source-map --style=compressed scss/coco-styles.scss:dist/coco.min.css",
    "lint": "npm-run-all --parallel sass:lint markdown:lint",
    "markdown:lint": "markdownlint-cli2 '**/*.md' '#node_modules' '#.site'",
    "package:verify": "node scripts/verify-package.mjs",
    "sass:lint": "stylelint 'scss/**/*.scss' 'test/**/*.scss'",
    "sass:lint:fix": "stylelint scss/**/*.scss --fix",
    "start": "npm-run-all --parallel pug sass:preview serve",
    "test": "node --test",
    "test:all": "npm-run-all audit lint test build preview:build preview:validate package:verify",
    "preview:build": "npm-run-all pug:build sass:preview:build",
    "preview:validate": "html-validate 'preview/html/page/*.html'",
    "sass:preview:build": "sass --no-source-map --style=expanded scss/coco-styles.scss:preview/assets/css/coco.css",
    "docs:build": "npm-run-all build preview:build docs:generate docs:validate",
    "docs:generate": "node scripts/build-docs.mjs",
    "docs:validate": "html-validate '.site/index.html' '.site/api/index.html'"
  },
  "license": "CORE",
  "devDependencies": {
    "@anduh/pug-cli": "^1.0.0-alpha8",
    "autoprefixer": "^10.5.4",
    "del-cli": "^7.0.0",
    "html-validate": "^11.12.0",
    "kss-modern": "^1.2.2",
    "markdownlint-cli2": "^0.23.2",
    "npm-run-all2": "^8.0.4",
    "postcss-cli": "^11.0.1",
    "sass": "^1.103.1",
    "sassdoc-parser": "^3.4.1",
    "sass-true": "^10.1.0",
    "serve": "^14.2.6",
    "stylelint": "^17.14.1",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-order": "^8.1.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "unpkg": "dist/coco.css",
  "style": "dist/coco.min.css",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "npm@12.0.2"
}
